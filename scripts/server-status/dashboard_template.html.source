<!doctype html>
<html lang="RESOURCE_LANGUAGE"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Oxygen / Carbon</title>
<style>
:root{color-scheme:light dark;--bg:#f4f6f8;--paper:#fff;--ink:#172b3a;--muted:#6d7d89;--line:#e1e7eb;--faint:#f2f5f7;--accent:#08796c;--warm:#a45c13;--focus:#1a5cc5}
@media(prefers-color-scheme:dark){:root{--bg:#121a20;--paper:#1a252d;--ink:#edf5f8;--muted:#a2b4c0;--line:#35444e;--faint:#25333d;--accent:#72d7bc;--warm:#f3b464;--focus:#9cc4ff}}
*{box-sizing:border-box}body{margin:0;padding:24px;background:var(--bg);color:var(--ink);font:14px/1.45 system-ui,-apple-system,sans-serif}button{font:inherit;color:inherit;cursor:pointer}main{max-width:1120px;margin:auto}.shell{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:25px 30px}h1{font-size:21px;letter-spacing:-.4px;margin:0}h2{font-size:15px;margin:0}p{margin:0}.muted{color:var(--muted)}.top{display:flex;justify-content:space-between;align-items:center;gap:15px}.tabs{display:flex;gap:5px;background:var(--faint);padding:4px;border-radius:11px}.tab{background:transparent;border:0;border-radius:8px;padding:8px 20px;color:var(--muted);font-weight:600;text-transform:capitalize}.tab[aria-selected=true]{background:var(--paper);color:var(--ink);box-shadow:0 1px 3px #00000016}.status{font-size:12px;color:var(--muted);margin-top:13px;min-height:18px}.status::before{content:'';display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%;margin-right:7px}.status.warning{color:var(--warm)}.status.warning::before{background:var(--warm)}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:24px;border-bottom:1px solid var(--line);padding:22px 0 21px}.metric-label{color:var(--muted);font-size:12px}.value{font-size:28px;line-height:1.2;letter-spacing:-.6px;font-weight:620;font-variant-numeric:tabular-nums}.unit{font-size:16px;font-weight:450;letter-spacing:0;color:var(--muted);margin-left:5px}.total{color:var(--muted);font-size:12px;margin-top:2px}.gpus{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin:18px 0 23px}.gpu{border:1px solid var(--line);border-radius:10px;padding:12px 15px}.gpu-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px}.gpu-name{font-size:12px;font-weight:600}.gpu-count{font-size:20px;font-weight:650;font-variant-numeric:tabular-nums}.gpu-state{font-size:11px;color:var(--muted)}.gpu-detail{font-size:10px;color:var(--muted);margin-top:5px}.gpu-detail summary{cursor:pointer}.gpu-occupancy{margin-top:18px;margin-bottom:0}.gpu-util{font-size:23px;font-weight:620;font-variant-numeric:tabular-nums}.gpu-util small{font-size:12px;color:var(--muted);margin-left:2px}.bar{height:4px;border-radius:5px;overflow:hidden;background:var(--faint);margin:6px 0 8px}.bar span{display:block;height:100%;background:var(--accent)}.gpu-bottom{margin-top:8px;display:flex;justify-content:space-between;gap:9px;font-size:12px}.gpu-program{color:var(--muted);font-size:11px;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.core-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:13px}.legend{display:flex;gap:9px;font-size:10px;color:var(--muted);white-space:nowrap}.swatch{display:inline-block;vertical-align:middle;width:9px;height:9px;margin-right:3px;background:var(--faint);border:1px solid var(--line);border-radius:2px}.swatch.busy{background:color-mix(in srgb,var(--accent) 30%,var(--paper))}.sockets{display:grid;grid-template-columns:1fr 1fr;gap:24px}.socket-label{font-size:11px;color:var(--muted);margin-bottom:7px}.core-grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:5px}.core{min-width:0;height:61px;border:1px solid var(--line);border-radius:6px;background:var(--faint);padding:5px;text-align:center;position:relative}.core-id{font-size:10px;color:var(--muted)}.core.idle{color:var(--muted)}.core.idle .core-id{font-size:12px}.core.active{background:color-mix(in srgb,var(--accent) var(--shade,10%),var(--paper));border-color:color-mix(in srgb,var(--accent) 20%,var(--line))}.core-util{display:block;font-size:15px;font-weight:650;font-variant-numeric:tabular-nums;line-height:1.2}.core-program{display:block;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:12px;margin-top:1px}.core[aria-pressed=true]{outline:2px solid var(--accent);outline-offset:1px}.core:focus-visible,.tab:focus-visible{outline:3px solid var(--focus);outline-offset:2px}.selection{background:var(--faint);border-radius:9px;padding:11px 14px;margin-top:17px;display:grid;grid-template-columns:180px 1fr;gap:15px;align-items:center;min-height:63px}.selected-title{font-size:12px;font-weight:650}.selected-subtitle{font-size:10px;color:var(--muted)}.threads{display:flex;gap:24px;flex-wrap:wrap}.thread{font-size:12px;display:flex;gap:8px;align-items:baseline}.thread-id{color:var(--muted);font-size:11px}.thread-use{font-weight:650;font-variant-numeric:tabular-nums}.thread-name{overflow-wrap:anywhere}.foot{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:10px;margin-top:13px}.empty{color:var(--muted);padding:20px 0}.warning-message{color:var(--warm);font-size:12px}.gpu-failed{grid-column:1/-1;padding:12px;border:1px solid var(--line);border-radius:8px}
@media(max-width:800px){body{padding:14px}.shell{padding:20px}.sockets{gap:16px}.core-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.core{height:56px}.selection{grid-template-columns:1fr;gap:5px}.threads{gap:18px}.value{font-size:26px}}
@media(max-width:500px){body{padding:8px}.shell{padding:17px 14px;border-radius:13px}.top{display:block}h1{font-size:19px}.tabs{margin-top:12px;display:grid;grid-template-columns:repeat(3,1fr)}.tab{padding:8px}.metrics{gap:12px;padding:18px 0}.value{font-size:24px}.unit{font-size:12px;margin-left:3px}.gpus{grid-template-columns:1fr;margin:15px 0 20px}.core-head{align-items:start}.core-head .muted{display:block}.sockets{grid-template-columns:1fr;gap:14px}.core-grid{grid-template-columns:repeat(8,minmax(0,1fr))}.core{height:52px;padding:3px}.core-program{font-size:8px}.core-util{font-size:12px}.core.idle .core-id{font-size:10px}.threads{display:grid;grid-template-columns:1fr;gap:3px}.foot{display:block;font-size:9px}.foot span{display:block}.selection{margin-top:14px}}
.storage{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:15px 0;margin-bottom:20px}.storage-head{display:flex;justify-content:space-between;gap:10px;align-items:center}.disk-list{display:flex;gap:8px;flex-wrap:wrap;margin:9px 0;color:var(--muted);font-size:11px}.disk-list span{background:var(--faint);padding:4px 7px;border-radius:5px}.storage table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px;font-variant-numeric:tabular-nums}.storage th,.storage td{text-align:right;padding:7px 4px;border-bottom:1px solid var(--line)}.storage th{font-size:10px;color:var(--muted);font-weight:500}.storage th:first-child,.storage td:first-child{text-align:left;width:43%;overflow-wrap:anywhere}.storage tbody tr:last-child td{border:0}.volume-device{display:block;font-size:10px;color:var(--muted)}.space-warning{font-size:10px;color:var(--warm)}.storage .low td:last-child{color:var(--warm);font-weight:650}.storage-status{font-size:10px;color:var(--muted)}@media(max-width:500px){.storage table{font-size:10px}.storage th:first-child,.storage td:first-child{width:40%}.storage th{font-size:9px}.disk-list{font-size:10px}.storage td,.storage th{padding:6px 2px}.storage-head{align-items:start}}
.node-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.node{border:1px solid var(--line);background:var(--faint);padding:10px;border-radius:8px;min-width:0;text-align:left}.node.busy{background:color-mix(in srgb,var(--accent) 8%,var(--paper))}.node[aria-pressed=true]{outline:2px solid var(--accent)}.node-top{display:flex;justify-content:space-between;gap:6px}.node-name{font-size:12px;font-weight:650}.node-state{font-size:9px;color:var(--muted)}.node-count{font-size:18px;font-weight:600;font-variant-numeric:tabular-nums;margin:5px 0}.node-jobs{font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.node-detail{display:grid;gap:4px;font-size:11px}.job-details{margin-top:16px;font-size:12px}.job-details summary{cursor:pointer;color:var(--muted)}.job-details table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:10px;margin-top:7px}.job-details th,.job-details td{border-bottom:1px solid var(--line);padding:5px;text-align:left;overflow-wrap:anywhere}.job-details th{font-weight:500;color:var(--muted)}.job-details th:first-child{width:48%}.cluster-note{font-size:11px;color:var(--muted);margin:6px 0 12px}@media(max-width:500px){.node-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.node-count{font-size:16px}.node-state{font-size:8px}.job-details th:first-child{width:42%}.job-details td,.job-details th{padding:4px 2px}}
.performance{font-size:11px;color:var(--muted);padding:12px 0 0}.performance summary{cursor:pointer}.performance b{color:var(--ink);font-weight:600}.performance p{margin-top:6px;max-width:900px}
.usage-months th:first-child{width:22%}.usage-months td{vertical-align:top}.usage-months td:first-child{font-variant-numeric:tabular-nums}.rankings{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:10px 0 18px}.rankings table{font-size:12px}.rankings th:first-child{width:16%}.rankings td:nth-child(3),.rankings th:nth-child(3){text-align:right}.rankings td{font-variant-numeric:tabular-nums}.rankings h2{margin-bottom:8px}@media(max-width:500px){.rankings{grid-template-columns:1fr;gap:18px}.rankings table{font-size:12px}}</style></head><body><main><section class="shell">
<div class="top"><h1 id="title"></h1><nav class="tabs" id="tabs" role="tablist"></nav></div>
<section id="job-counter" hidden style="margin:16px 0;padding:16px;border:1px solid var(--line);border-radius:9px;background:var(--faint)"></section>
<div id="panel" role="tabpanel"><p id="status" class="status"></p><div id="metrics" class="metrics"></div><div class="gpu-occupancy core-head"><h2 id="gpu-heading"></h2><b id="gpu-count" class="gpu-count"></b></div><div id="gpus" class="gpus"></div>
<details id="performance" class="performance"></details>
<section id="storage" class="storage"></section>
<div class="core-head"><h2 id="core-heading"></h2><div class="legend" id="legend"></div></div><div id="sockets" class="sockets"></div><div id="selection" class="selection" aria-live="polite"></div><div id="cluster-jobs" hidden></div></div>
<section id="cluster-usage" class="job-details" hidden></section>
<div class="foot"><span id="sampling-note"></span><span>GB = 10⁹ bytes · TB = 10¹² bytes</span></div>
</section><noscript>JavaScript required.</noscript></main>
<script id="resource-data" type="application/json">RESOURCE_JSON_PAYLOAD</script><script>
'use strict';
const labels=RESOURCE_LABELS;
const data=JSON.parse(document.getElementById('resource-data').textContent);
const servers=data.servers||[data],byId=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=(n,d=1)=>Number.isFinite(n)?n.toFixed(d):'—',gb=n=>n*1073741824/1e9;
const percent=n=>Number.isFinite(n)?Math.min(100,Math.max(0,n)):0;
const fraction=(n,total)=>String(n??'?')+' / '+String(total??'?');
const time=s=>new Intl.DateTimeFormat(document.documentElement.lang==='en'?'en-GB':'ko-KR',{timeZone:'Asia/Seoul',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(s));
const nice=name=>/^matlab(?:$|[_\.\-])/i.test(name)?'MATLAB':/^orca(?:$|[_\.\-])/i.test(name)?'ORCA':/^(?:lmp(?:$|[_\.\-])|lammps(?:$|[_\.\-]))/i.test(name)?'LAMMPS':name;
const displayHost=host=>host==='sg'?'SG-Master':host;
let activeHost=data.host||servers[0].host,selected=new Map(),coreMap=new Map();
byId('title').textContent=labels.title;document.title=labels.title+' · '+displayHost(activeHost);
byId('tabs').setAttribute('aria-label',labels.host);byId('sampling-note').textContent=labels.sampleNote;
byId('legend').innerHTML='<span><i class="swatch"></i>'+esc(labels.idle)+'</span><span><i class="swatch busy"></i>'+esc(labels.active)+'</span>';
function current(){const s=servers.find(s=>s.host===activeHost)||servers[0];return {s,c:s.latest.status==='ok'?s.latest:s.last_good};}
function stateLine(s,c){const l=s.latest,age=(Date.now()-new Date(l.local_completed_at_utc))/60000;let state=labels.ok,warning=false;if(l.status!=='ok'){state=labels.failed+(c?' · '+labels.lastGood+' '+time(c.local_completed_at_utc)+' KST':' · '+labels.unknown);warning=true;}else if(age>data.stale_after_minutes){state=labels.stale;warning=true;}else if(l.kind==='slurm_cluster'){if(!l.query_ok?.queue){state=labels.queueFailed;warning=true;}}else if(!l.gpu_query_ok){state=labels.gpuFailed;warning=true;}return {text:time(l.local_completed_at_utc)+' KST · '+state,warning};}
function details(key){const core=coreMap.get(key);if(!core)return;selected.set(activeHost,key);document.querySelectorAll('.core').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.key===key)));byId('selection').innerHTML='<div><div class="selected-title">'+esc(labels.socket)+' '+core.socket+' · '+esc(labels.core)+' '+core.id+'</div><div class="selected-subtitle">'+esc(labels.smt)+'</div></div><div class="threads">'+core.threads.map(t=>'<div class="thread"><span class="thread-id">T'+t.logical_cpu+'</span><span class="thread-use">'+fmt(t.utilization_percent)+'%</span><span class="thread-name">'+esc(t.utilization_percent<1?labels.idle:t.programs?.length?t.programs.join(' · '):labels.noName)+'</span></div>').join('')+'</div>';}
const capacity=n=>Number.isFinite(n)?(n>=1e12?(n/1e12).toFixed(2)+' TB':(n/1e9).toFixed(n>0&&n<1e8?3:1)+' GB'):'—';
function renderStorage(c){const st=c?.storage,el=byId('storage');if(!st||st.status==='unavailable'){el.innerHTML='<h2>'+esc(labels.storage)+'</h2><p class="storage-status">'+esc(labels.storageUnknown)+'</p>';return;}
el.innerHTML='<div class="storage-head"><h2>'+esc(labels.storage)+'</h2>'+(st.low_space_filesystems?'<span class="space-warning" title="'+esc(labels.storageWarning)+'">'+esc(labels.lowSpace)+' · '+st.low_space_filesystems+'</span>':'')+'</div><div class="disk-list" aria-label="'+esc(labels.disks)+'">'+st.disks.map(d=>'<span>'+esc(d.device)+' · '+capacity(d.size_bytes)+(d.media?' '+esc(d.media):'')+'</span>').join('')+'</div><table><thead><tr><th>'+esc(labels.mount)+'</th><th>'+esc(labels.total)+'</th><th>'+esc(labels.used)+'</th><th title="'+esc(labels.storageWarning)+'">'+esc(labels.available)+'</th></tr></thead><tbody>'+st.volumes.map(v=>{const mounted=v.status==='mounted',warning=v.space_status==='low'||v.space_status==='full';return '<tr class="'+(warning?'low':'')+'"><td>'+esc(v.mounts?.length?v.mounts.join(' · '):v.device||labels.unknown)+'<span class="volume-device">'+esc([v.mounts?.length?v.device:null,v.fstype,v.mount_access==='read_only'?labels.readOnly:null,mounted?null:labels[v.status],!mounted?labels.blockSize:null].filter(Boolean).join(' · '))+'</span></td><td title="'+esc(mounted?'':labels.blockSize)+'">'+capacity(mounted?v.total_bytes:v.size_bytes)+'</td><td>'+capacity(v.used_bytes)+'</td><td>'+capacity(v.available_bytes)+(warning?'<span class="volume-device space-warning">'+esc(v.space_status==='full'?labels.fullSpace:labels.lowSpace)+'</span>':'')+'</td></tr>';}).join('')+'</tbody></table>'+(st.status==='partial'?'<p class="storage-status">'+esc(labels.storagePartial)+'</p>':'');}
let nodeMap=new Map();
function usageRanks(r){if(!r)return '—';const lines=(r.rows||[]).map(x=>'#'+x.rank+' '+esc(x.name)+' · <b>'+x.jobs.toLocaleString()+'</b> '+esc(labels.countJobs));if(r.unassigned_jobs)lines.push(esc(labels.unassigned)+' · '+r.unassigned_jobs.toLocaleString()+' '+esc(labels.countJobs));return lines.join('<br>')||esc(labels.noNamedAccounts);}
function rankingTable(r){if(!r?.rows?.length)return '<p class="cluster-note">'+esc(labels.noRetainedStarts)+'</p>';return '<table><thead><tr><th>'+esc(labels.rankNumber)+'</th><th>User</th><th>'+esc(labels.rankingJobs)+'</th></tr></thead><tbody>'+r.rows.map(x=>'<tr><td>'+x.rank+'</td><td>'+esc(x.name)+'</td><td>'+x.jobs.toLocaleString()+'</td></tr>').join('')+'</tbody></table>';}
function renderUsage(c,fresh){const el=byId('cluster-usage'),u=c?.usage;el.hidden=!u;if(!u)return;const h=u.historical||{},cfg=u.accounting_config||{};let html='<p class="cluster-note">'+esc(labels.rankingScope)+'<br>'+esc(labels.retainedPeriod)+': '+esc((h.first_retained_start||'?').slice(0,10))+' → '+esc((h.last_retained_start||'?').slice(0,10))+' KST</p>';
if(u.disclosure==='local_review')html+='<p class="warning-message">'+esc(labels.localReview)+'</p>';
if(h.status!=='ok')html+='<p class="warning-message">'+esc(labels.usageUnavailable)+'</p>';
else if(!['approved','local_review'].includes(u.disclosure))html+='<p class="cluster-note">'+esc(labels.approvalPending)+'</p>';
else html+='<div class="rankings"><section><h2>'+esc(labels.allTop5)+'</h2>'+rankingTable(h.top5)+'</section><section><h2>'+esc(labels.lastMonthTop3)+' · '+esc(h.last_month?.month||'?')+'</h2>'+rankingTable(h.last_month?.ranking)+'</section></div>';
html+='<details><summary>'+esc(labels.methodDetails)+'</summary><p class="cluster-note">'+esc(labels.usageMetric)+'<br>'+esc(labels.retention)+': '+esc(cfg.PurgeJobAfter||'?')+' · step '+esc(cfg.PurgeStepAfter||'?')+'<br>'+esc(u.all_users_visible?labels.allUsers:labels.scopeUnverified)+'<br>'+esc(labels.notLifetime)+'</p>';
if(h.status==='ok'){html+='<p class="cluster-note">'+esc(labels.audit)+' · '+(h.audit?.logical_started_jobs??'?').toLocaleString()+' '+esc(labels.countJobs)+' · '+esc(labels.requeuesRemoved)+' '+(h.audit?.requeue_records_collapsed??0)+' · '+esc(labels.noStartRemoved)+' '+(h.audit?.no_actual_start??0).toLocaleString()+'</p>';if(h.lineage_inferred)html+='<p class="cluster-note">'+esc(labels.lineageBounds)+': '+h.count_lower_bound.toLocaleString()+'–'+h.count_upper_bound.toLocaleString()+'</p>';}
html+='<p class="cluster-note">'+esc(labels.purgeCaveat)+'</p></details>';el.innerHTML=html;}
function performanceNumber(value){return typeof value==='number'&&Number.isFinite(value)?value.toFixed(1):'?';}
function nodeCpuReference(name){const g=data.nominal_fp32?.sg?.node_groups?.find(group=>group.nodes.includes(name));if(!g)return '';return '<span>CPU: '+esc(g.cpu_model)+' · '+performanceNumber(g.base_GHz)+' GHz</span><span>'+esc(labels.fp32)+' '+performanceNumber(g.fp32_TFLOPS)+' · '+esc(labels.fp64)+' '+performanceNumber(g.fp64_TFLOPS)+' TFLOPS</span>';}
function nodeGpuObservation(n){
 const o=n.gpu_observation,stamp=o?.checked_at_utc;
 const valid=typeof stamp==='string'&&/(?:Z|[+-]\d{2}:\d{2})$/.test(stamp);
 const age=(Date.now()-Date.parse(stamp))/60000;
 const row=current().s.latest,parentAge=(Date.now()-Date.parse(row.local_completed_at_utc))/60000;
 if(row.status!=='ok'||!Number.isFinite(parentAge)||parentAge < -5||parentAge>data.stale_after_minutes||!valid||o.status!=='ok'||!Number.isFinite(age)||age < -5||age>data.stale_after_minutes||!Array.isArray(o.gpus)||o.gpus.length!==n.configured_gpus||!o.gpus.length)return null;
 return o;
}
function nodeGpuCards(n){
 const o=nodeGpuObservation(n);
 if(!o)return '<article class="gpu"><div class="gpu-head"><span class="gpu-name">'+esc(n.name)+' · '+(n.configured_gpus??'?')+' GPU</span><span class="gpu-state">'+esc(labels.notSampled)+'</span></div><div class="gpu-bottom"><span class="muted">'+esc(labels.vram)+'</span><b>? GB</b></div></article>';
 return o.gpus.map(g=>'<article class="gpu"><div class="gpu-head"><span class="gpu-name">'+esc(n.name)+' · GPU '+g.index+' · '+esc(g.name.replace(/^NVIDIA /,''))+'</span><span class="gpu-state">'+esc(labels.ok)+'</span></div><div class="gpu-bottom"><span class="muted">'+esc(labels.vram)+'</span><b>'+fmt(gb(g.memory_free_gib))+' / '+fmt(gb(g.memory_total_gib))+' GB</b></div><p class="gpu-detail">'+esc(labels.utilization)+' '+fmt(g.utilization_percent)+'% · '+esc(time(o.checked_at_utc))+' KST</p><p class="gpu-detail">'+esc(labels.sampleNote)+'</p></article>').join('');
}
function nodeGpuDetails(n){const o=nodeGpuObservation(n);return o?o.gpus.map(g=>'<span>GPU '+g.index+' · '+esc(g.name)+' · '+esc(labels.vram)+': '+fmt(gb(g.memory_free_gib))+' / '+fmt(gb(g.memory_total_gib))+' GB · '+esc(labels.utilization)+' '+fmt(g.utilization_percent)+'%</span>').join(''):'';}
function nodeDetails(name){const n=nodeMap.get(name);if(!n)return;selected.set(activeHost,name);document.querySelectorAll('.node').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.node===name)));byId('selection').innerHTML='<div><div class="selected-title">'+esc(n.name)+' · '+esc(n.state)+'</div><div class="selected-subtitle">'+esc(n.partitions.join(' · '))+'</div></div><div class="node-detail">'+nodeCpuReference(name)+'<span>'+esc(labels.allocatedCpu)+': '+fraction(n.slurm_cpus_allocated,n.slurm_cpus_total)+'</span><span>'+esc(labels.topology)+': '+fraction(n.sockets,'?').split(' / ')[0]+' × '+(n.cores_per_socket??'?')+' '+esc(labels.physical)+' · '+(n.threads_per_core??'?')+' '+esc(labels.threadsPerCore)+'</span><span>'+esc(labels.allocatedRam)+': '+capacity(n.memory_allocated_bytes)+' / '+capacity(n.memory_total_bytes)+'</span><span>'+esc(labels.osFree)+': '+capacity(n.slurm_free_memory_bytes)+' · '+esc(labels.notAvailable)+'</span><span>'+esc(labels.allocatedGpu)+': '+fraction(n.allocated_gpus,n.configured_gpus)+'</span>'+nodeGpuDetails(n)+'<span>'+esc(labels.jobLabels)+': '+esc(n.job_labels.length?n.job_labels.map(j=>j.name+' #'+j.id).join(' · '):labels.noAssignedJobs)+'</span></div>';}
function renderJobCounter(c,fresh){const el=byId('job-counter'),j=c?.job_counter;el.hidden=!j;if(!j)return;const id=fresh&&j.status==='ok'&&Number.isSafeInteger(j.latest_job_id)?j.latest_job_id.toLocaleString():'?';el.innerHTML='<p class="metric-label">'+esc(labels.jobCounter)+'</p><p class="value">'+id+'</p><p class="cluster-note">'+esc(labels.jobCounterNote)+'<br>'+esc(labels.jobIdLimit)+': '+(j.MaxJobId?.toLocaleString()??'?')+' · '+esc(j.checked_at_utc?time(j.checked_at_utc):'?')+' KST<br>'+esc(labels.cumulativeReview)+'</p>';}
function renderCluster(s,c,fresh){renderJobCounter(c,fresh);renderUsage(c,fresh);byId('storage').hidden=true;byId('sockets').className='node-grid';byId('sampling-note').textContent=labels.masterScope+' '+labels.clusterNote;byId('legend').textContent=labels.allocationNote;
byId('metrics').innerHTML='<div><p class="metric-label" title="'+esc(labels.allocationNote)+'">'+esc(labels.allocatedCpu)+'</p><p class="value">'+fraction(fresh?c.slurm_cpus_allocated:null,c.slurm_cpus_total)+'</p><p class="total">'+esc(labels.computeNodes)+' '+c.node_count+' · '+esc(labels.nodesAllocated)+' '+(fresh?c.nodes_with_allocations??'?':'?')+'</p></div><div><p class="metric-label">'+esc(labels.allocatedRam)+'</p><p class="value">'+capacity(fresh?c.memory_allocated_bytes:null)+' / '+capacity(c.memory_total_bytes)+'</p><p class="total">'+(c.memory_allocation_tracked===false?esc(labels.memoryTrackingOff):esc(labels.allocationNote))+'</p></div>';
byId('gpu-heading').textContent=labels.allocatedGpu;byId('gpu-heading').title=labels.gpuClusterNote;byId('gpu-count').textContent=fraction(fresh?c.allocated_gpus:null,c.configured_gpus);byId('gpu-count').title=labels.gpuClusterNote;
const gpuNodes=c.nodes.filter(n=>n.configured_gpus>0);byId('gpus').innerHTML=gpuNodes.length?gpuNodes.map(nodeGpuCards).join(''):'<p class="gpu-failed muted">'+esc(labels.notSampled)+'</p>';
byId('core-heading').textContent=labels.computeNodes+' · '+c.node_count;nodeMap=new Map(c.nodes.map(n=>[n.name,n]));byId('sockets').innerHTML=c.nodes.map(n=>'<button class="node '+(n.slurm_cpus_allocated>0?'busy':'')+'" data-node="'+esc(n.name)+'" aria-pressed="false"><span class="node-top"><span class="node-name">'+esc(n.name)+'</span><span class="node-state">'+esc(n.state)+'</span></span><div class="node-count">'+fraction(fresh?n.slurm_cpus_allocated:null,n.slurm_cpus_total)+'</div><div class="node-jobs" title="'+esc(n.job_labels.map(j=>j.name).join(' · '))+'">'+esc(n.job_labels.length?n.job_labels.map(j=>j.name).join(' · '):labels.noAssignedJobs)+'</div></button>').join('');
nodeDetails(nodeMap.has(selected.get(activeHost))?selected.get(activeHost):c.nodes.find(n=>n.slurm_cpus_allocated>0)?.name||c.nodes[0]?.name);
const queueFresh=fresh&&c.query_ok?.queue;byId('metrics').insertAdjacentHTML('beforeend','<p class="total" style="grid-column:1/-1">'+esc(labels.runningJobs)+' <b>'+(queueFresh?(c.job_states?.RUNNING??0):'?')+'</b> · '+esc(labels.pendingJobs)+' <b>'+(queueFresh?(c.job_states?.PENDING??0):'?')+'</b> · '+esc(labels.masterScope)+'</p>');
const jobs=byId('cluster-jobs');jobs.hidden=false;jobs.innerHTML='<details class="job-details"><summary>'+esc(labels.visibleJobs)+' '+(c.visible_job_count??'?')+' · '+Object.entries(c.job_states||{}).map(([st,n])=>esc(st)+' '+n).join(' · ')+'</summary><p class="cluster-note">'+esc(labels.jobLabelsNote)+(c.jobs_truncated?' '+esc(labels.jobsLimit):'')+'</p><table><thead><tr><th>'+esc(labels.jobLabels)+'</th><th>'+esc(labels.state)+'</th><th>'+esc(labels.allocatedCpu)+'</th><th>'+esc(labels.nodes)+'</th></tr></thead><tbody>'+c.jobs.map(j=>'<tr><td>'+esc(j.name)+'<span class="volume-device">#'+esc(j.id)+'</span></td><td>'+esc(j.state)+'</td><td>'+(j.slurm_cpus??'?')+'</td><td>'+esc(j.nodes.length?j.nodes.join(', '):'—')+'</td></tr>').join('')+'</tbody></table></details>';}

function renderPerformance(){const p=data.nominal_fp32?.[activeHost], d=data.nominal_fp64?.[activeHost];const el=byId('performance');el.hidden=!p;if(!p)return;el.innerHTML='<summary>'+esc(labels.fp32)+' · CPU <b>'+performanceNumber(p.cpu_TFLOPS)+'</b> · GPU <b>'+performanceNumber(p.gpu_TFLOPS)+'</b> TFLOPS</summary>'+(d?'<p>'+esc(labels.fp64)+' · CPU <b>'+performanceNumber(d.cpu_TFLOPS)+'</b> · GPU <b>'+performanceNumber(d.gpu_TFLOPS)+'</b> TFLOPS</p>':'')+'<p>'+esc(labels.precisionNote)+'</p><p>'+esc(labels.precisionFormula)+'</p>'; }

function render(){byId('job-counter').hidden=true;byId('cluster-usage').hidden=true;renderPerformance();const {s,c}=current();const state=stateLine(s,c);const fresh=s.latest.status==='ok'&&(Date.now()-new Date(s.latest.local_completed_at_utc))/60000<=data.stale_after_minutes;document.title=labels.title+' · '+displayHost(activeHost);byId('tabs').innerHTML=servers.map(s=>'<button class="tab" role="tab" id="tab-'+esc(s.host)+'" aria-controls="panel" aria-selected="'+(s.host===activeHost)+'" tabindex="'+(s.host===activeHost?'0':'-1')+'" data-host="'+esc(s.host)+'">'+esc(displayHost(s.host))+'</button>').join('');byId('panel').setAttribute('aria-labelledby','tab-'+activeHost);byId('status').textContent=state.text;byId('status').className='status'+(state.warning?' warning':'');if(!c){byId('cluster-jobs').hidden=true;byId('metrics').innerHTML='<p class="empty">'+esc(labels.unknown)+'</p>';byId('gpus').replaceChildren();byId('gpu-heading').textContent=labels.gpuCount;byId('gpu-count').textContent='? / ?';byId('sockets').replaceChildren();byId('selection').replaceChildren();renderStorage(null);byId('core-heading').textContent=labels.cores;return;}
if(s.latest.kind==='slurm_cluster'||c.kind==='slurm_cluster'){renderCluster(s,c,fresh);return;}
byId('storage').hidden=false;byId('cluster-jobs').hidden=true;byId('sockets').className='sockets';byId('legend').innerHTML='<span><i class="swatch"></i>'+esc(labels.idle)+'</span><span><i class="swatch busy"></i>'+esc(labels.active)+'</span>';byId('sampling-note').textContent=labels.sampleNote;
renderStorage(c);
const occupancy=c.occupancy||{},cpu=occupancy.cpu||{},gpu=occupancy.gpu||{};
byId('metrics').innerHTML='<div><p class="metric-label" tabindex="0" title="'+esc(labels.cpuCriterion)+'">'+esc(labels.cpu)+'</p><p class="value">'+fraction(fresh&&cpu.known?cpu.active:null,cpu.total??c.physical_cores)+'<span class="unit">'+esc(labels.physical)+'</span></p></div><div><p class="metric-label">'+esc(labels.ram)+'</p><p class="value">'+fmt(gb(c.memory_available_gib))+'<span class="unit">GB</span></p><p class="total">'+esc(labels.of)+' '+fmt(gb(c.memory_total_gib))+' GB</p></div>';
byId('gpu-heading').textContent=labels.gpuCount;byId('gpu-heading').title=labels.gpuCriterion;byId('gpu-count').textContent=fraction(fresh&&gpu.known?gpu.active:null,gpu.total);byId('gpu-count').title=labels.gpuCriterion;
byId('gpus').innerHTML=c.gpu_query_ok?c.gpus.map(g=>'<article class="gpu"><div class="gpu-head"><span class="gpu-name">GPU '+g.index+' · '+esc(g.name.replace(/^NVIDIA /,''))+'</span><span class="gpu-state">'+esc(labels['gpu_'+(gpu.states?.[String(g.index)]||'unknown')])+'</span></div><div class="gpu-bottom"><span class="muted">'+esc(labels.vram)+'</span><b>'+fmt(gb(g.memory_free_gib))+' / '+fmt(gb(g.memory_total_gib))+' GB</b></div>'+(g.processes.length?'<p class="gpu-program">'+[...new Set(g.processes.map(p=>p.name))].map(esc).join(' · ')+'</p>':'')+'<details class="gpu-detail"><summary>'+esc(labels.details)+'</summary>'+esc(labels.utilization)+' '+fmt(g.utilization_percent)+'%</details></article>').join(''):'<p class="gpu-failed warning-message">'+esc(labels.gpuFailed)+'</p>';
byId('core-heading').innerHTML=esc(labels.cores)+' <span class="muted" style="font-size:11px;font-weight:400">'+c.physical_cores+' '+esc(labels.physical)+' / '+c.logical_cpus+' '+esc(labels.threads)+'</span>';
coreMap.clear();for(const t of c.cpu_threads||[]){const socket=t.socket??'?',id=t.physical_core??('T'+t.logical_cpu),key=socket+':'+id;if(!coreMap.has(key))coreMap.set(key,{socket,id,key,threads:[]});coreMap.get(key).threads.push(t);}const groups=new Map();for(const core of coreMap.values()){core.use=core.threads.reduce((a,t)=>a+t.utilization_percent,0)/core.threads.length;core.active=core.threads.some(t=>t.utilization_percent>=1);core.programs=[...new Set(core.threads.filter(t=>t.utilization_percent>=1).flatMap(t=>t.programs||[]).map(nice))];if(!groups.has(core.socket))groups.set(core.socket,[]);groups.get(core.socket).push(core);}
byId('sockets').innerHTML=[...groups].sort((a,b)=>Number(a[0])-Number(b[0])).map(([socket,cores])=>'<section><div class="socket-label">'+esc(labels.socket)+' '+socket+'</div><div class="core-grid">'+cores.sort((a,b)=>Number(a.id)-Number(b.id)).map(core=>{const title=labels.core+' '+core.id+' · '+fmt(core.use)+'% · '+(core.programs.join(' · ')||(core.active?labels.noName:labels.idle));return '<button class="core '+(core.active?'active':'idle')+'" data-key="'+esc(core.key)+'" style="--shade:'+Math.max(5,Math.round(percent(core.use)*.48))+'%" aria-pressed="false" aria-label="'+esc(title)+'" title="'+esc(title)+'"><span class="core-id">C'+esc(core.id)+'</span>'+(core.active?'<span class="core-program" style="margin-top:8px;font-size:10px">'+esc(core.programs.join(' / '))+'</span>':'')+'</button>';}).join('')+'</div></section>').join('');if(!coreMap.size){byId('selection').innerHTML='<p class="muted">'+esc(labels.noCores)+'</p>';return;}const key=selected.get(activeHost);details(coreMap.has(key)?key:[...coreMap.values()].sort((a,b)=>b.use-a.use)[0].key);}
byId('tabs').addEventListener('click',e=>{const b=e.target.closest('[data-host]');if(b){activeHost=b.dataset.host;render();byId('tab-'+activeHost).focus();}});
byId('tabs').addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();const i=servers.findIndex(s=>s.host===activeHost);activeHost=servers[(i+(e.key==='ArrowRight'?1:servers.length-1))%servers.length].host;render();byId('tab-'+activeHost).focus();}});
byId('sockets').addEventListener('click',e=>{const b=e.target.closest('[data-key]');if(b)details(b.dataset.key);const n=e.target.closest('[data-node]');if(n)nodeDetails(n.dataset.node);});
render();setInterval(()=>{const {s,c}=current(),state=stateLine(s,c);byId('status').textContent=state.text;byId('status').className='status'+(state.warning?' warning':'');},60000);
</script></body></html>

